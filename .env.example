# .env.example - Environment Variables Template
# PT. Holly Xaviera Export
# Copy this file to .env and fill in your values

# ==========================================================================
# Application Settings
# ==========================================================================

# Application environment (development, staging, production)
NODE_ENV=production

# Base URL of the application
BASE_URL=https://www.hollyxavieraexport.com

# API Version
API_VERSION=v1

# Cache version (increment to bust cache)
CACHE_VERSION=1.0.0

# ==========================================================================
# Supabase Configuration
# ==========================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (for client-side)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for server-side only - NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================================================
# Security Settings
# ==========================================================================

# Rate limiting (requests per minute)
RATE_LIMIT_CONTACT_FORM=5
RATE_LIMIT_API=60

# Session timeout (in minutes)
SESSION_TIMEOUT=30

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://www.hollyxavieraexport.com,https://hollyxavieraexport.com

# ==========================================================================
# Email Configuration (for contact form notifications)
# ==========================================================================

# SMTP host
SMTP_HOST=smtp.gmail.com

# SMTP port
SMTP_PORT=587

# SMTP user
SMTP_USER=your-email@gmail.com

# SMTP password (use app password for Gmail)
SMTP_PASSWORD=your-app-password

# Email from address
EMAIL_FROM=noreply@hollyxavieraexport.com

# Email recipient for inquiries
EMAIL_TO_INQUIRIES=info@hollyxavieraexport.com

# ==========================================================================
# PWA Settings
# ==========================================================================

# PWA Theme Color
PWA_THEME_COLOR=#2d501a

# PWA Background Color
PWA_BACKGROUND_COLOR=#f5f1e8

# PWA Display Mode (standalone, fullscreen, minimal-ui, browser)
PWA_DISPLAY=standalone

# ==========================================================================
# Analytics & Monitoring
# ==========================================================================

# Google Analytics ID (optional)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager ID (optional)
GTM_ID=GTM-XXXXXXX

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://xxxxxxx@sentry.io/xxxxxxx

# ==========================================================================
# Build Settings
# ==========================================================================

# Output directory for build
BUILD_OUTPUT_DIR=dist

# Enable source maps (false for production)
SOURCE_MAPS=false

# Enable minification
MINIFY=true

# Target browsers for build
BROWSERSLIST_DEFAULTS=>0.5%, last 2 versions, Firefox ESR, not dead

# ==========================================================================
# CDN Configuration (optional)
# ==========================================================================

# CDN base URL for assets
CDN_BASE_URL=https://cdn.hollyxavieraexport.com

# Enable CDN for production
USE_CDN=false

# ==========================================================================
# Feature Flags
# ==========================================================================

# Enable PWA install prompt
ENABLE_PWA_PROMPT=true

# Enable offline support
ENABLE_OFFLINE=true

# Enable push notifications
ENABLE_PUSH_NOTIFICATIONS=false

# Enable background sync
ENABLE_BACKGROUND_SYNC=false

# ==========================================================================
# Database Table Names
# ==========================================================================

TABLE_PRODUCTS=products
TABLE_ARTICLES=articles
TABLE_SETTINGS=settings
TABLE_INQUIRIES=inquiries
TABLE_USERS=users

# ==========================================================================
# Image Optimization
# ==========================================================================

# Max image width for responsive images
IMAGE_MAX_WIDTH=1920

# Image quality (1-100)
IMAGE_QUALITY=85

# Enable WebP conversion
ENABLE_WEBP=true

# Enable AVIF conversion
ENABLE_AVIF=false

# ==========================================================================
# Logging
# ==========================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=error

# Enable console logging (disable for production)
ENABLE_CONSOLE_LOG=false

# ==========================================================================
# Maintenance Mode
# ==========================================================================

# Enable maintenance mode
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE=We are currently undergoing scheduled maintenance. Please check back soon.
